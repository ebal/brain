# Environment=BRAIN_SYNC_BACKUP_KEEP=14
# ExecStart=/usr/bin/node server/backup.js
#
# [Unit]
# Description=Daily Brain Sync backup
# [Timer]
# OnCalendar=daily
# Persistent=true
# [Install]
# WantedBy=timers.target
